rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /deletion_requests/{requestId} {
      allow create: if isValidDeletionRequest();
      allow read, update, delete: if false;
    }
  }
}

function isValidDeletionRequest() {
  let data = request.resource.data;
  return data.keys().hasAll(['email', 'status', 'createdAt', 'source'])
    && data.email is string
    && data.email.size() >= 5
    && data.email.size() <= 320
    && data.email.matches('.*@.*\\..*')
    && data.status == 'pending'
    && data.source is string
    && data.source.size() <= 32
    && (!('name' in data) || (data.name is string && data.name.size() <= 120))
    && (!('details' in data) || (data.details is string && data.details.size() <= 2000));
}
