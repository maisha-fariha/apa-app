# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# Fixes Xcode Archive "Module 'app_links' not found" with Flutter plugins.
install! 'cocoapods', :disable_input_output_paths => true

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# flutter_stripe 11.x presents Payment Sheet via AppDelegate.window, which is nil
# under Flutter UIScene. Rewrite lookups to use the scene key window.
def patch_stripe_ios_uiscene!
  stripe_root = File.expand_path('.symlinks/plugins/stripe_ios', __dir__)
  return unless Dir.exist?(stripe_root)

  helper_name = 'ApaStripeKeyWindow'
  old = 'UIApplication.shared.delegate?.window??.rootViewController'
  new = "#{helper_name}()?.rootViewController"
  helper = <<~SWIFT

    // APA: UIScene-safe key window (flutter_stripe 11.x still uses AppDelegate.window).
    func #{helper_name}() -> UIWindow? {
        let scenes = UIApplication.shared.connectedScenes.compactMap { $0 as? UIWindowScene }
        if let key = scenes.flatMap({ $0.windows }).first(where: { $0.isKeyWindow }) {
            return key
        }
        return UIApplication.shared.delegate?.window ?? nil
    }
  SWIFT

  patched_files = []
  Dir.glob(File.join(stripe_root, '**', '*.swift')).each do |path|
    contents = File.read(path)
    next unless contents.include?(old)

    File.write(path, contents.gsub(old, new))
    patched_files << path
    puts "Patched Stripe UIScene presenter: #{File.basename(path)}"
  end
  return if patched_files.empty?

  host = Dir.glob(File.join(stripe_root, '**/StripeSdk.swift')).first || patched_files.first
  host_contents = File.read(host)
  return if host_contents.include?("func #{helper_name}()")

  File.write(host, host_contents + helper)
  puts "Added #{helper_name}() to #{File.basename(host)}"
end

target 'Runner' do
  # Static linkage is required for reliable Flutter plugin modules on Archive.
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      # Xcode 16 Explicit Modules breaks @import in GeneratedPluginRegistrant.m
      config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
      config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
      config.build_settings['DEFINES_MODULE'] = 'YES'
    end
  end

  installer.pods_project.build_configurations.each do |config|
    config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
    config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
  end

  patch_stripe_ios_uiscene!
end
